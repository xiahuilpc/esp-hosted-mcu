# sdkconfig overlay for ESP32-C6 co-processor: SPI Full-duplex, Zephyr 4.x host
# Handshake pin: IO15 (user-specified)
# All other SPI pins use ESP32-C6 standalone defaults:
#   MOSI = GPIO7, MISO = GPIO2, SCLK = GPIO6, CS = GPIO10
# Data Ready = GPIO4, Reset = -1 (reuse EN pin)

# 1. Transport: SPI Full-duplex
CONFIG_ESP_SPI_HOST_INTERFACE=y

# 2. Override handshake GPIO to IO15
CONFIG_ESP_SPI_GPIO_HANDSHAKE=15
